{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "../worker/test/**/*.ts",
    "**/*.ts",
    "../src/lib/**/*.ts",
    "../src/types/**/*.d.ts",
    "../functions/**/*.ts"
  ]
}
